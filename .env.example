# Скопируйте в .env.local и заполните своими значениями.
# На VPS: те же ключи в Environment Variables.

# --- Telegram-бот для заявок ---
BOT_TOKEN=
CHAT_ID=

# --- Админка договоров ---
# Пароль для входа в /admin. Придумайте свой.
ADMIN_PASSWORD=

# URL сайта (для ссылок на договоры в админке):
APP_URL=http://localhost:3000

# --- База данных договоров (SQLite) ---
# Абсолютный путь (на VPS — вне папки кода, чтобы не терялась при деплое):
# DATABASE_PATH=/var/lib/vitaliy/contracts.db
# Локально по умолчанию: data/contracts.db
DATABASE_PATH=
