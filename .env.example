# Скопируйте в .env.local и заполните своими значениями.
# На Vercel/VPS: те же ключи в Environment Variables.

# --- Telegram-бот для заявок ---
BOT_TOKEN=
CHAT_ID=

# --- Админка счетов ---
# Пароль для входа в /admin. Придумайте свой.
ADMIN_PASSWORD=

# --- Оплата (Т-Банк / Tinkoff Kassa) ---
# mock — оплата сымитирована (для теста); tbank — реальные платежи.
PAYMENT_PROVIDER=mock
# Получите в личном кабинете Т-Банка при подключении эквайринга:
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# URL сайта (для коллбеков Т-Банка и success/fail страниц):
APP_URL=http://localhost:3000

# --- База данных счетов (SQLite) ---
# Абсолютный путь (на VPS — вне папки кода, чтобы не терялась при деплое):
# DATABASE_PATH=/var/lib/vitaliy/invoices.db
# Локально по умолчанию: data/invoices.db
DATABASE_PATH=
