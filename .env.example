# Скопируйте в .env.local и заполните своими значениями.
# На Vercel: те же ключи в Environment Variables.

# --- Telegram-бот для заявок ---
BOT_TOKEN=
CHAT_ID=

# --- Админка договоров ---
# Пароль для входа в /admin. Придумайте свой.
ADMIN_PASSWORD=

# URL сайта (для ссылок на договоры в админке):
APP_URL=http://localhost:3000

# --- База данных договоров (Turso / libSQL) ---
# На проде (Vercel): URL и токен базы Turso (turso.io, бесплатный тариф).
# Локально без этих переменных используется файл data/contracts.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
